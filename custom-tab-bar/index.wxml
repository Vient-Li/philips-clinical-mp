<view class="tabbar">
  <view
    class="tab-item"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <image class="tab-icon {{selected === index ? 'on' : ''}}" src="{{item.icon}}" mode="aspectFit" />
    <text class="tab-text {{selected === index ? 'on' : ''}}">{{item.text}}</text>
  </view>
</view>
