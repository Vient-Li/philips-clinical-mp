.page {
  background: #ffffff;
  min-height: 100vh;
}

/* 自定义导航栏 */
.topbar {
  background: #ffffff;
}

.topbar-inner {
  height: 88rpx;
  padding: 0 27rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  width: 150rpx;
  height: 27rpx;
}

/* 右上角只留一个搜索位，其余让给系统胶囊 */
.search-entry {
  height: 60rpx;
  padding: 0 20rpx;
  background: #f2f3f5;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
}

.search-icon {
  font-size: 28rpx;
  color: #8a8f99;
  margin-right: 8rpx;
}

.search-text {
  font-size: 24rpx;
  color: #8a8f99;
}

/* Banner */
.banner {
  width: 750rpx;
  height: 417rpx;
}

.banner-img {
  width: 750rpx;
  height: 417rpx;
  display: block;
}

/* 科室九宫格 */
.dept-wrap {
  display: flex;
  flex-wrap: wrap;
  padding: 22rpx 20rpx 6rpx;
}

.dept-cell {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 18rpx;
}

.dept-icon {
  width: 150rpx;
  height: 144rpx;
}

.divider {
  height: 2rpx;
  background: #ececec;
  margin: 10rpx 30rpx 18rpx;
}

/* 分类入口 */
.cat-wrap {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 27rpx 30rpx;
}

.cat-item {
  width: 162rpx;
  height: 154rpx;
}

/* 系列课程：父页面保留课程入口，推荐与活动由底部导航承接 */
.courses {
  background: #ffffff;
  padding: 30rpx 27rpx 20rpx;
}

.course-grid {
  display: flex;
  flex-wrap: wrap;
  column-gap: 16rpx;
  row-gap: 16rpx;
  margin-top: 18rpx;
}

.course-card {
  width: calc((100% - 16rpx) / 2);
  background: #ffffff;
  border-radius: 14rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(15, 40, 90, 0.08);
}

.course-cover {
  width: 100%;
  height: 221rpx;
  display: block;
}

.course-body {
  padding: 12rpx 14rpx 16rpx;
}

.course-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 36rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.course-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8f99;
  line-height: 32rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0050d0;
  line-height: 48rpx;
}

.section-title.light {
  color: #ffffff;
}

.section-more {
  font-size: 24rpx;
  color: #8a8f99;
}

.course-more {
  min-width: 88rpx;
  padding-left: 24rpx;
  color: #0050d3;
  line-height: 48rpx;
  text-align: right;
}

.section-more.light {
  color: rgba(255, 255, 255, 0.88);
}

/* 尾部转化区 */
.footer {
  margin: 10rpx 27rpx 30rpx;
  padding: 30rpx 28rpx;
  background: #f5f7fa;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
}

.footer-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.footer-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.footer-btns {
  margin-top: 22rpx;
  display: flex;
}

.footer-btn {
  flex: 1;
  margin: 0;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  border-radius: 38rpx;
  padding: 0;
}

.footer-btn::after {
  border: none;
}

.footer-btn.ghost {
  color: #0050d3;
  background: #ffffff;
  border: 1rpx solid #cfe0ff;
  margin-right: 16rpx;
}

.footer-btn.solid {
  color: #ffffff;
  background: #0050d3;
}

.tabbar-holder {
  height: 160rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
