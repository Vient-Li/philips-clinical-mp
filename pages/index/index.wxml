<view class="page">
  <!-- 自定义导航栏：左边 logo，右边只留一个搜索位；胶囊那块由 navRight 让出来 -->
  <view class="topbar" style="padding-top: {{statusBarHeight}}px;">
    <view class="topbar-inner" style="padding-right: {{navRight}}px;">
      <image class="logo" src="/assets/logo.png" mode="aspectFit" />
      <view class="search-entry" hover-class="press" bindtap="onSearch">
        <text class="search-icon">⌕</text>
        <text class="search-text">搜索课程、资料</text>
      </view>
    </view>
  </view>

  <!-- Banner：3 张，主推活动 / 直播 / 系列课 -->
  <swiper
    class="banner"
    autoplay
    circular
    interval="4000"
    duration="400"
    indicator-dots
    indicator-color="rgba(255,255,255,0.45)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image class="banner-img" src="{{item.img}}" mode="aspectFill" hover-class="press" bindtap="onBanner" data-index="{{index}}" />
    </swiper-item>
  </swiper>

  <!-- 按科室找人（医疗业务的主轴） -->
  <view class="dept-wrap">
    <view class="dept-cell" wx:for="{{depts}}" wx:key="id" hover-class="press" bindtap="onDept" data-id="{{item.id}}" data-name="{{item.name}}">
      <image class="dept-icon" src="{{item.icon}}" mode="aspectFit" />
    </view>
  </view>

  <view class="divider"></view>

  <!-- 按内容类型分流 -->
  <view class="cat-wrap">
    <image
      class="cat-item"
      wx:for="{{cats}}"
      wx:key="id"
      src="{{item.img}}"
      mode="aspectFit"
      hover-class="press"
      bindtap="onCat"
      data-id="{{item.id}}"
      data-name="{{item.name}}"
    />
  </view>

  <!-- 最新活动：横滑 3 张，点进去进活动详情（子页面下一阶段接入） -->
  <view class="activity">
    <view class="section-head">
      <text class="section-title light">最新活动</text>
      <text class="section-more light" hover-class="press" bindtap="toActivity">全部活动 ›</text>
    </view>
    <scroll-view class="act-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="act-card" wx:for="{{activities}}" wx:key="id">
        <view class="act-cover-wrap">
          <image
            class="act-cover"
            src="{{item.cover}}"
            mode="aspectFill"
            hover-class="press"
            bindtap="onAct"
            data-index="{{index}}"
          />
          <text class="act-badge">{{item.badge}}</text>
        </view>
        <view class="act-body">
          <text class="act-title">{{item.title}}</text>
          <text class="act-meta">{{item.short}}</text>
          <view class="act-cta" hover-class="press" bindtap="onAct" data-index="{{index}}">
            <text class="act-cta-text">{{item.cta}}</text>
            <text class="act-cta-arrow">›</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 系列课程：两列 6 个 -->
  <view class="courses">
    <view class="section-head">
      <text class="section-title">系列课程</text>
      <text class="section-more" hover-class="press" bindtap="toRecommend">全部课程 ›</text>
    </view>
    <view class="course-grid">
      <view
        class="course-card"
        wx:for="{{courses}}"
        wx:key="id"
        hover-class="press"
        bindtap="onCourse"
        data-id="{{item.id}}"
      >
        <image class="course-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="course-body">
          <text class="course-title">{{item.title}}</text>
          <text class="course-sub">{{item.sub}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 父页面尾部：留资表单下一阶段接入，这里先给客服入口 -->
  <view class="footer">
    <text class="footer-title">需要方案或报价？</text>
    <text class="footer-desc">留个电话，临床团队一个工作日内联系你</text>
    <view class="footer-btns">
      <button class="footer-btn ghost" open-type="contact" bindtap="onContact">在线咨询</button>
    </view>
  </view>

  <view class="tabbar-holder"></view>
</view>
