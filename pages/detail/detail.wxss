.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 220rpx;
}

.cover {
  width: 750rpx;
  height: 420rpx;
  display: block;
}

.body {
  padding: 28rpx 32rpx 0;
}

.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #0050d3;
  background: #eef4ff;
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 10rpx 0;
}

.tag.kind {
  color: #ffffff;
  background: #0050d3;
}

.title {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 56rpx;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8a8f99;
}

.facts {
  margin-top: 24rpx;
  background: #f7f9fc;
  border-radius: 14rpx;
  padding: 8rpx 22rpx;
}

.fact {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eef1f6;
}

.fact:last-child {
  border-bottom: none;
}

.fact-label {
  width: 110rpx;
  font-size: 24rpx;
  color: #8a8f99;
}

.fact-value {
  flex: 1;
  font-size: 26rpx;
  color: #2b3038;
}

.hr {
  height: 1rpx;
  background: #f0f1f3;
  margin: 28rpx 0;
}

.block {
  margin-bottom: 26rpx;
  display: flex;
  flex-direction: column;
}

.block-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 44rpx;
}

.block-text {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #4a4f57;
  line-height: 48rpx;
}

.notice {
  margin: 8rpx 0 30rpx;
  padding: 20rpx 22rpx;
  background: #fafbfc;
  border-radius: 12rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #9aa0a8;
  line-height: 34rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(15, 40, 90, 0.08);
}

.bar-contact {
  margin: 0;
  width: 128rpx;
  height: 88rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: #4a4f57;
}

.bar-contact::after {
  border: none;
}

.bar-contact-icon {
  font-size: 30rpx;
  line-height: 32rpx;
  color: #0050d3;
}

.bar-contact-text {
  font-size: 20rpx;
  line-height: 26rpx;
  color: #6b7280;
}

.bar-cta {
  flex: 1;
  margin: 0 0 0 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #0050d3;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.bar-cta::after {
  border: none;
}

.bar-cta.done {
  background: #eef4ff;
  color: #0050d3;
}

.empty {
  padding-top: 200rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 28rpx;
}
