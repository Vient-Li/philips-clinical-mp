<view class="page" wx:if="{{!done}}">
  <view class="hero">
    <text class="hero-tag">{{heroTag}}</text>
    <text class="hero-title">{{activityTitle}}</text>
    <text class="hero-when" wx:if="{{whenText}}">{{whenText}}</text>
    <text class="hero-desc">提交后飞利浦团队会与您确认参会信息</text>
  </view>

  <view class="form">
    <view class="field">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入您的姓名" value="{{form.name}}" data-key="name" bindinput="onInput" maxlength="20" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="用于接收参会通知" value="{{form.phone}}" data-key="phone" bindinput="onInput" maxlength="11" />
      <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhone">一键填写</button>
    </view>
    <view class="field">
      <text class="label">医院</text>
      <input class="input" placeholder="请输入医院名称" value="{{form.hospital}}" data-key="hospital" bindinput="onInput" maxlength="40" />
    </view>
    <view class="field">
      <text class="label">科室</text>
      <picker range="{{deptNames}}" value="{{deptIndex}}" bindchange="onDeptChange">
        <view class="picker">{{deptNames[deptIndex]}}<text class="arrow">›</text></view>
      </picker>
    </view>
    <view class="field field-col">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="想了解的产品或问题（选填）" value="{{form.note}}" data-key="note" bindinput="onInput" maxlength="200" />
    </view>
  </view>

  <view class="agree">
    <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree"></view>
    <text class="agree-text" bindtap="toggleAgree">我已阅读并同意《个人信息收集与使用说明》</text>
  </view>

  <button class="submit" loading="{{submitting}}" bindtap="onSubmit">提交报名</button>
  <view class="safe"></view>
</view>

<view class="success" wx:else>
  <view class="success-icon">✓</view>
  <text class="success-title">报名已提交</text>
  <text class="success-desc">我们会尽快与您联系，请保持手机畅通</text>
  <button class="success-btn" bindtap="backHome">返回首页</button>
</view>
